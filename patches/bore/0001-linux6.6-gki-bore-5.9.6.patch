 11 files changed, 668 insertions(+), 3 deletions(-)

diff --git a/include/linux/sched.h b/include/linux/sched.h
index 8a06cb7..b8040ce 100644
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -525,6 +525,15 @@ struct sched_statistics {
 #endif /* CONFIG_SCHEDSTATS */
 } ____cacheline_aligned;
 
+#ifdef CONFIG_SCHED_BORE
+struct sched_burst_cache {
+	u64				timestamp;
+	spinlock_t		lock;
+	u16				count;
+	u8				score;
+};
+#endif // CONFIG_SCHED_BORE
+
 struct sched_entity {
 	/* For load-balancing: */
 	struct load_weight		load;
@@ -533,7 +542,16 @@ struct sched_entity {
 	u64				min_vruntime;
 
 	struct list_head		group_node;
+	/* bore-kabi: genksyms must see the stock decl below, else the CRC of every
+	 * type graph that reaches sched_entity drifts (measured on 6.6.77 GKI:
+	 * 5,965 symbols incl. the module_layout canary) and OEM MODVERSIONS
+	 * vendor modules are rejected at first-stage init -> boot panic. */
+#ifdef __GENKSYMS__
 	unsigned int			on_rq;
+#else
+	unsigned char			on_rq;
+	unsigned char			rel_deadline;
+#endif
 
 	u64				exec_start;
 	u64				sum_exec_runtime;
@@ -565,10 +583,29 @@ struct sched_entity {
 	struct sched_avg		avg;
 #endif
 
+#ifdef CONFIG_SCHED_BORE
+	/* bore-kabi: 6.6 burst state in KABI slots (DroidSpaces method) */
+	_ANDROID_KABI_REPLACE(
+		ANDROID_KABI_RESERVE(1);
+		ANDROID_KABI_RESERVE(2),
+		struct {
+			u64	burst_time;
+			u8	prev_burst_penalty;
+			u8	curr_burst_penalty;
+			u8	burst_penalty;
+			u8	burst_score;
+		});
+	_ANDROID_KABI_REPLACE(
+		ANDROID_KABI_RESERVE(3);
+		ANDROID_KABI_RESERVE(4),
+		struct sched_burst_cache child_burst;
+	);
+#else
 	ANDROID_KABI_RESERVE(1);
 	ANDROID_KABI_RESERVE(2);
 	ANDROID_KABI_RESERVE(3);
 	ANDROID_KABI_RESERVE(4);
+#endif
 };
 
 struct sched_rt_entity {
@@ -1521,3 +1521,16 @@ struct task_struct {
-	ANDROID_KABI_RESERVE(3);
-	ANDROID_KABI_RESERVE(4);
+#ifdef CONFIG_SCHED_BORE
+	/* bore-kabi: group_burst in KABI slots 3-4. Google's dmabuf_info /
+	 * user_dumpable ANDROID_KABI_USE blocks consume slots 1-2 on the
+	 * android15-6.6 release branches from 2025-08 on; DroidSpaces sysvipc
+	 * consumes 6-8. RESERVE(3)/(4) are free on every 6.6 pin, so this hunk
+	 * anchors only on RESERVE(3)/(4)/(5) and serves every 6.6 tree. */
+	_ANDROID_KABI_REPLACE(
+		ANDROID_KABI_RESERVE(3);
+		ANDROID_KABI_RESERVE(4),
+		struct sched_burst_cache group_burst;
+	);
+#else
+	ANDROID_KABI_RESERVE(3);
+	ANDROID_KABI_RESERVE(4);
+#endif
 	ANDROID_KABI_RESERVE(5);
