vruntime = 0x000001FD286B87E3
cfs_rq->min_vruntime = 0x000009E040BCE59A
avg_vruntime = 0xF1F78909FE6F47DC
avg_load = 0x0016E699
(vruntime - cfs_rq->min_vruntime) * load = (0x000001FD286B87E3-0x000009E040BCE59A)*0x0016E699, so multiplication overflow occurs.

