Origin: android.googlesource.com/kernel/common 793e15e9dee4d752fdde29029ed97ef464389784
Batch: B-3b (P4 pre-window sweep 2025-04..2026-01) - Class A, apply as-is; predicted ABI delta zero

---
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index bd4defd66..c5fc889e2 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -981,6 +981,12 @@ found:
 	if (!best || (curr && entity_before(curr, best)))
 		best = curr;
 
+	/* EEVDF search sched entity fail, so picking leftmost */
+	if (!best) {
+		best = __pick_first_entity(cfs_rq);
+		printk_deferred("EEVDF scheduling fail, picking leftmost\n");
+	}
+
 	return best;
 }
 
