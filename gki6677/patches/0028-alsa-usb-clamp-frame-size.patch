Signed-off-by: Sonali Pradhan <sonalipradhan@google.com>
(cherry picked from commit 60cf931c5a95dacbbd86483d5d0978e80a756ccd)
Signed-off-by: Sonali Pradhan <sonalipradhan@google.com>

Origin: android.googlesource.com/kernel/common bf768be0eed008588dc4e0db0b2f76c026a35818
Batch: B-1 (P4 stability & functional backports) - Class A, apply as-is; predicted ABI delta zero

---
diff --git a/sound/usb/endpoint.c b/sound/usb/endpoint.c
index fd37acbdc1..4c7212300c 100644
--- a/sound/usb/endpoint.c
+++ b/sound/usb/endpoint.c
@@ -1835,11 +1835,13 @@ static void snd_usb_handle_sync_urb(struct snd_usb_endpoint *ep,
 
 		out_packet->packets = in_ctx->packets;
 		for (i = 0; i < in_ctx->packets; i++) {
-			if (urb->iso_frame_desc[i].status == 0)
-				out_packet->packet_size[i] =
+			if (urb->iso_frame_desc[i].status == 0) {
+				unsigned int frames =
 					urb->iso_frame_desc[i].actual_length / sender->stride;
-			else
+				out_packet->packet_size[i] = min(frames, ep->maxframesize);
+			} else {
 				out_packet->packet_size[i] = 0;
+			}
 		}
 
 		spin_unlock_irqrestore(&ep->lock, flags);
